{
  "name": "cv-maker",
  "version": "1.0.0",
  "private": true,
  "description": "CV Maker — create, manage and download professional CVs from 50+ templates.",
  "scripts": {
    "dev": "npm run templates:registry && next dev",
    "prebuild": "npm run templates:registry",
    "build": "next build",
    "build:thumbnails": "npm run templates:registry && next build && npm run thumbnails",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "templates:registry": "node scripts/generate-registry.mjs",
    "templates:scaffold": "node scripts/scaffold-templates.mjs && node scripts/generate-registry.mjs",
    "thumbnails": "node scripts/generate-thumbnails.mjs",
    "thumbnails:force": "node scripts/generate-thumbnails.mjs --force"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^6.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.4.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.2",
    "playwright": "^1.64.1",
    "prettier": "3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
